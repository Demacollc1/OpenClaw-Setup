# Variables del servidor MCP de Bitrix24. NO subas este archivo con valores reales.

# Webhook ENTRANTE de Bitrix24 (mismo que usa el workflow). Permisos: crm, imopenlines.
# Formato: https://TUCUENTA.bitrix24.es/rest/1/XXXXXXXXXXXXXXXX  (sin barra final)
BITRIX_WEBHOOK_URL=https://tucuenta.bitrix24.es/rest/1/xxxxxxxxxxxxxxxx

# Puerto donde el MCP expone el endpoint SSE (/sse).
MCP_PORT=3001

# (Opcional pero recomendado) token Bearer que el cliente MCP debe enviar.
# Si lo defines, configura la misma auth en el nodo "MCP Client Tool" de n8n.
MCP_AUTH_TOKEN=

# Codigos de campo personalizado de Bitrix24 para RUC/Cedula (ajusta a tu cuenta).
BITRIX_RUC_FIELD_LEAD=UF_CRM_1535722030
BITRIX_RUC_FIELD_CONTACT=UF_CRM_5B89426D4565C
