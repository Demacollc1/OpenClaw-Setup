# Variables de entorno para el workflow de n8n (Demaco RoberthV2 + Ollama)
# En n8n se configuran en Settings > Variables (o como variables de entorno del
# contenedor/servicio n8n). NO subas este archivo con valores reales.

# --- Bitrix24 (Cloud) ---
# Webhook ENTRANTE de Bitrix24 con permisos: imbot, im, imopenlines, crm.
# Formato: https://TUCUENTA.bitrix24.es/rest/1/XXXXXXXXXXXXXXXX
BITRIX_WEBHOOK_URL=https://tucuenta.bitrix24.es/rest/1/xxxxxxxxxxxxxxxx

# ID del chatbot registrado con imbot.register (lo devuelve esa llamada).
BITRIX_BOT_ID=123

# Token de seguridad que Bitrix24 envia en auth[application_token] al registrar el
# bot/handler. Sirve para validar que el evento viene realmente de tu Bitrix24.
BITRIX_OUTBOUND_TOKEN=pega_aqui_el_application_token

# (Opcional) ID del asesor/cola a quien transferir cuando el cliente pide "Operador".
BITRIX_OPERATOR_ID=1

# --- Ollama ---
# URL base de tu servidor Ollama (sin barra final).
# El workflow determinista (A) la usa en su nodo HTTP a /api/chat. En el workflow
# con AI Agent (B), la URL de Ollama se configura en la credencial "Ollama" de n8n.
OLLAMA_URL=http://localhost:11434
# Modelo a usar (debe estar descargado: `ollama pull llama3.1`).
OLLAMA_MODEL=llama3.1
